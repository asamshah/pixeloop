# Copy to .env.local. Ad-platform credentials are NOT set here: customers add
# them in the app at /connect (validated, then stored encrypted).

# Required in production. Encrypts stored ad credentials (AES-256-GCM).
#   openssl rand -base64 32
# Losing this key makes stored credentials unreadable (users just reconnect).
# In `npm run dev` a key is generated automatically into data/.secret-key.
ENCRYPTION_KEY=

# Safety: approvals only log actions until this is explicitly "false"
ADS_DRY_RUN=true

# Optional: plain-English audit summaries written by Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional shared password (HTTP Basic, any username) for the dashboard, the
# credential form and the APIs. Strongly recommended for any deployed instance.
APP_PASSWORD=

# MCP server over HTTP at /api/mcp. Disabled unless set (use a long random value).
MCP_API_KEY=

# Weekly audits. `next start` / self-hosted runs them in-process.
# On serverless hosts set DISABLE_SCHEDULER=true and call GET /api/cron/audit
# from an external cron with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# DISABLE_SCHEDULER=true

# Defaults to a local SQLite file. Use a Turso URL for hosted deployments.
# DATABASE_URL=file:./data/ads-agent.db
# DATABASE_AUTH_TOKEN=

# META_API_VERSION=v23.0
# SHOPIFY_API_VERSION=2026-07
